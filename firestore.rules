rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Admin = a document exists in /admins/{uid}
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Admin accounts: admins can read the list and create/remove admins.
    match /admins/{uid} {
      allow read: if request.auth != null
        && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }

    // Customer accounts. Only admins can create customers or change balances.
    match /users/{uid} {
      allow read: if request.auth != null
        && (request.auth.uid == uid || isAdmin());
      allow create, update, delete: if isAdmin();

      // Transaction history: customer reads own, admin writes
      match /transactions/{txId} {
        allow read: if request.auth != null
          && (request.auth.uid == uid || isAdmin());
        allow write: if isAdmin();
      }
    }

    // Shipments. Public read keeps the existing tracking page working.
    // Customer dashboards filter by customerTrackingId in the app.
    // Only admins can create or change shipments.
    match /shipments/{shipmentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Site settings, such as maintenance mode. Everyone can read it so the
    // site can close for visitors; only admins can change it.
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Support chat: one chat per customer (chat id = customer uid).
    // Customers and admins can read and write their own chat; admins see all.
    match /chats/{uid} {
      allow read, write: if request.auth != null
        && (request.auth.uid == uid || isAdmin());

      match /messages/{msgId} {
        allow read: if request.auth != null
          && (request.auth.uid == uid || isAdmin());
        allow create: if request.resource.data.text is string
          && request.resource.data.text.size() <= 1000
          // An attachment must link to our Cloudinary account and have an allowed extension
          && (!("attachment" in request.resource.data)
            || (request.resource.data.attachment.url is string
              && request.resource.data.attachment.url.matches("https://res[.]cloudinary[.]com/v9ef25wm/.*[.](jpe?g|png|gif|webp|pdf|docx?|xlsx?|csv|txt|zip)")
              && request.resource.data.attachment.name is string
              && request.resource.data.attachment.name.size() <= 200))
          && ((request.auth.uid == uid && request.resource.data.from == "customer")
            || (isAdmin() && request.resource.data.from == "admin"));
        allow update, delete: if false;
      }
    }

    // Deny everything else by default
  }
}
